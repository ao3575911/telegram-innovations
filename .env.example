# Copy to .env, chmod 600 .env, and edit locally. Never commit the configured file.
# .env is trusted shell syntax: load it with `set -a; . ./.env; set +a`.
# Obtain a bot token from Telegram's @BotFather. Keep privacy mode enabled.
BOT_TOKEN=
# Generate once: python3 -c 'import secrets; print(secrets.token_hex(32))'
# Keep this key with your database backups. Changing it breaks ownership/forget matching.
IDENTITY_SECRET=
DATABASE_PATH=data/rallypoint.sqlite3
LOG_LEVEL=INFO
# Empty means JSON to stderr only. A file enables rotation at 1 MiB, five backups.
LOG_FILE=
# Final cards are removed after this many days. Telegram messages are not deleted.
RETENTION_DAYS=7
# Optional comma-separated numeric Telegram user IDs, never usernames.
# Operator diagnostics are also restricted to private chats.
ADMIN_IDS=
